{
    "configurations": [
        {
            "name": "cross_amiga",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/amiga/m68k-amigaos/ndk-include/",
                "/opt/amiga/m68k-amigaos/include/",
                "/opt/amiga/m68k-amigaos/vbcc/include"
            ],
            "defines": [],
            "compilerPath": "/opt/amiga/bin/m68k-amigaos-g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "${default}"
        },
        {
            "name": "cross_morphos",
            "includePath": [
                "${workspaceFolder}/**",
                "/gg/include/",
                "/gg/os-include/",
                "/gg/includestd/"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/ppc-morphos-g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "${default}",
            "compilerPathInCppPropertiesJson": "/usr/bin/ppc-morphos-g++",
            "mergeConfigurations": false,
            "recursiveIncludes": {},
            "browse": {
                "limitSymbolsToIncludedHeaders": true
            },
            "compilerArgs": [
                "-std=c++17",
                "-D_NO_PPCINLINE"
            ]
        },
        {
            "name": "cross_aros",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/aros/Development/include/"
            ],
            "defines": [
                "__AROS__",
                "__AROS_X86_64"
            ],
            "compilerPath": "/opt/aros/bin/x86_64-aros-g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerArgs": [
                "--sysroot=/opt/aros/Development",
                "-std=gnu++17"
            ],
            "configurationProvider": "ms-vscode.makefile-tools"
        }
    ],
    "version": 4
}